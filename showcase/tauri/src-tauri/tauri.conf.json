{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roamies",
  "version": "0.1.35",
  "identifier": "com.kenkai.roamies",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/dist/": "sidecar/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5"
    },
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/node"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEMDhEN0E4RjYwMkVGRkUKUldUKzd3TDJxTmNJemFxcExCNkxUUk5KNlIyQlE1SmJyd24rNFJ6TDM2VS9kK0VTUmEyYW15dlMK",
      "endpoints": [
        "https://github.com/eleventhmetal-png/Roamies/releases/latest/download/latest.json",
        "https://raw.githubusercontent.com/eleventhmetal-png/Roamies/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
